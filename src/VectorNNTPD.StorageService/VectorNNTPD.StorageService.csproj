<Project Sdk="Microsoft.NET.Sdk.Worker">

  <Sdk Name="StuDev.AotAnywhere" Version="1.0.4" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VectorNNTPD.StorageService</RootNamespace>
    <AssemblyName>VectorNNTPD.StorageService</AssemblyName>
    <Description>VATP article ingress and cache advertisement host (VectorNNTPD.StorageService).</Description>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <UserSecretsId>dotnet-VectorNNTPD.StorageService-01550cb7-f86e-48f0-add1-591ca009f74f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VectorNNTPD.StorageService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VectorNNTPD.Common\VectorNNTPD.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="VectorNNTPD.StorageService.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="VectorNNTPD.StorageService.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="VectorNNTPD.RabbitMQ.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

