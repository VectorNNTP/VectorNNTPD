{
  "BackFiller": {
    "AcmeStateDir": "certs/",
    "ArticleRetention": {
      "MaximumRetainedPayloadGigabytes": 4,
      "MaxOpenableRequestIdsPerArticle": 16,
      "RetentionTtlSeconds": 10,
      "SweepIntervalSeconds": 1
    },
    "BackFillerAccountRefreshIntervalSeconds": 60,
    "BindAddress": [
      "198.18.0.66",
      "2c0f:f030:1442:501:198:18:0:66"
    ],
    "BindPortTls": 1190,
    "Listener": {
      "AwaitingReceiptAckTimeoutSeconds": 30,
      "IoProgressTimeoutSeconds": 60,
      "MaxActiveConnections": 1024,
      "MaxQueuedFoundPayloadBytes": 67108864,
      "ParserAccumulationMaxBytes": 262144,
      "ReceiveBufferBytes": 1048576,
      "SendBufferBytes": 2097152,
      "TlsHandshakeTimeoutSeconds": 30
    },
    "Nntp": {
      "MaxConcurrentSessionEstablishments": 8,
      "ReceiveBufferBytes": 2097152,
      "SendBufferBytes": 1048576
    },
    "Logging": {
      "LogLevel": "Information",
      "LogRetentionDays": 14,
      "Json": false,
      "File": {
        "Enabled": true,
        "LogDir": "logs"
      },
      "Syslog": {
        "Enabled": false,
        "Host": "",
        "Port": 514,
        "Protocol": "Udp"
      },
      "RabbitMQ": {
        "Enabled": false,
        "Exchange": "logs",
        "RoutingKey": "backfiller"
      }
    },
    "ServerId": 1,
    "Shutdown": {
      "DrainQueuedWork": true,
      "FinishActiveArticles": true,
      "GracePeriodSeconds": 30
    },
    "Systemd": {
      "EnableWatchdog": true,
      "NotifyReadyOnApplicationRunning": true,
      "NotifyStoppingOnApplicationShutdown": true,
      "ReportLifecycleStatus": true,
      "WatchdogIntervalFraction": 0.5
    }
  }
}
