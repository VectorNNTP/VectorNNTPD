<Project Sdk="Microsoft.NET.Sdk.Worker">

  <Sdk Name="StuDev.AotAnywhere" Version="1.0.4" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VectorNNTPD.BackFillerService</RootNamespace>
    <AssemblyName>VectorNNTPD.BackFillerService</AssemblyName>
    <Description>Usenet article recovery worker (VectorNNTPD.BackFillerService).</Description>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VectorNNTPD.BackFillerService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VectorNNTPD.Common\VectorNNTPD.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="VectorNNTPD.BackFillerService.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="VectorNNTPD.RabbitMQ.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
    <PackageReference Include="Serilog.Sinks.SyslogMessages" Version="4.1.0" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>


</Project>
