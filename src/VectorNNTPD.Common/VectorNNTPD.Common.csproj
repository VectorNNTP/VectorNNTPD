<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RootNamespace>VectorNNTPD.Common</RootNamespace>
    <AssemblyName>VectorNNTPD.Common</AssemblyName>
    <Description>Shared ACME, Cloudflare DNS, bind-address, high-performance listen/accept and System.IO.Pipelines duplex transport (SocketAcceptListener, NntpConnection), NntpDB, article-content primitives, Diablo article classification, ArticleRecord, ArticleId, OverviewDB protobuf wire contract, StorageServer cache-fleet advertisement JSON contract and topology name constants, byte-oriented article parsing, yEnc validation, canonical article materialization, Vector Article Transfer Protocol (VATP) framing, and RabbitMQ connectivity (connection lifecycle, channels) for VectorNNTP applications. RabbitMQ topology declaration, ArticleWork, NNTP session/command servers, and Management HTTP remain application-owned.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VectorNNTPD.Common.Tests" />
    <InternalsVisibleTo Include="VectorNNTPD.ReaderService" />
    <InternalsVisibleTo Include="VectorNNTPD.ReaderService.Tests" />
    <InternalsVisibleTo Include="VectorNNTPD.TransitService" />
    <InternalsVisibleTo Include="VectorNNTPD.TransitService.Tests" />
    <InternalsVisibleTo Include="VectorNNTPD.BackFillerService" />
    <InternalsVisibleTo Include="VectorNNTPD.BackFillerService.Tests" />
    <InternalsVisibleTo Include="VectorNNTPD.StorageService" />
    <InternalsVisibleTo Include="VectorNNTPD.StorageService.Tests" />
    <InternalsVisibleTo Include="VectorNNTP.StorageServer.PersistenceBench" />
    <InternalsVisibleTo Include="VectorNNTP.StorageQualification" />
    <!-- Storage smoke builds a pre-ingestion record with internal TryCreate(..., ArticlePathMode.Normalize).
         Public TryCreate always traverses and would prepend an application hop. Normalize stays internal. -->
    <InternalsVisibleTo Include="VectorNNTP.StorageSmoke" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02453" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
  </ItemGroup>

</Project>
