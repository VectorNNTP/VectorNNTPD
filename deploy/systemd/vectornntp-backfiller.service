[Unit]
Description=VectorNNTP BackFiller
# Install the flat linux-x64 release directory at this path. It contains
# VectorNNTPD.BackFillerService, VectorNNTPD.BackFillerService.json, VectorNNTPD.RabbitMQ.json,
# README.md, vectornntp-backfiller.service, and backfiller.env.example.
# Copy the unit to /etc/systemd/system/. Create user and group vectornntp,
# create logs/ and certs/ owned by that account, and install
# /etc/vectornntp/backfiller.env before enable.
Documentation=file:///opt/vectornntp/backfiller/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main

# Dedicated non-root service account (create before enabling the unit).
# Same account as NNTPD is acceptable when both share /opt/vectornntp.
User=vectornntp
Group=vectornntp

# The executable directory is the configuration root. The process loads
# VectorNNTPD.BackFillerService.json and VectorNNTPD.RabbitMQ.json from that directory,
# not appsettings.json, RabbitMq.json, or the process working directory.
# Relative logs (logs/) and ACME state (certs/) also resolve there.
WorkingDirectory=/opt/vectornntp/backfiller
ExecStart=/opt/vectornntp/backfiller/VectorNNTPD.BackFillerService

# Host ShutdownTimeout follows BackFiller:Shutdown:GracePeriodSeconds.
# The shipped value and the code default are 30; the valid maximum is 600.
# TimeoutStopSec must stay above that setting or systemd SIGKILLs an in-progress drain.
TimeoutStartSec=180
TimeoutStopSec=60

Restart=on-failure
RestartSec=5

# systemd reads this file as root before exec. The leading '-' suppresses errors
# reading the file and still starts the process. Current systemd ignores a missing,
# unreadable, or invalid file. That does not insert ConnectionStrings__NntpDB.
# Startup validation still fails when the variable is absent. The file is KEY=VALUE,
# not a shell script. An unquoted backslash is an escape. The connection string has
# no VECTOR__ prefix. RabbitMQ, ACME, and Cloudflare secrets come from
# nntpsharedconfig; this unit does not set them.
# backfiller__ and nntpd__ are not registered.
EnvironmentFile=-/etc/vectornntp/backfiller.env
# DOTNET_ENVIRONMENT selects the optional VectorNNTPD.BackFillerService.Production.json overlay.
Environment=DOTNET_ENVIRONMENT=Production

# Watchdog heartbeats run only when EnableWatchdog is true (the shipped default)
# and this unit sets WatchdogSec, which supplies WATCHDOG_USEC.
# Leave WatchdogSec unset until readiness has been checked on the target host.
# Example (enable only after validation):
# WatchdogSec=30
# Restart=on-watchdog

# File logging is the shipped destination (BackFiller:Logging:File:LogDir=logs).
# stdout and stderr still reach the journal. The console sink is off unless
# ExecStart includes --console.
# Hardening. BackFiller binds TLS and opens outbound NNTP, RabbitMQ, MySQL, and Cloudflare.
# ProtectSystem=strict mounts the filesystem read-only. ReadWritePaths re-opens only
# logs/ and certs/. It does not grant Unix ownership; those directories must already
# exist and be writable by the vectornntp account. The executable and JSON stay read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vectornntp/backfiller/logs /opt/vectornntp/backfiller/certs

KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
