# Installed as /etc/vectornntp/transit.env (root:root mode 0600).
# KEY=VALUE only. Unquoted backslash is an escape.
#
# Required database connection (no VECTOR__ prefix):
ConnectionStrings__NntpDB=REPLACE_WITH_MYSQL_CONNECTION_STRING
#
# Required AES-256 XTrace key (64 hex or Base64). Never commit the real value.
NNTPD__XTRACEKEY=REPLACE_WITH_32_BYTE_KEY_AS_64_HEX_OR_BASE64
#
# Site-specific Nntpd overrides use Nntpd__* (section name Nntpd is preserved).
# Do not invent bind addresses, zone ids, or peer catalogues here; set them for the deployment.
# Example: Nntpd__ServerId=1
# Example: Nntpd__DnsSuffix=example.test
