# systemd EnvironmentFile for vectornntp-storageservice.service.
# One KEY=VALUE per line. A line whose first non-space character is # is a comment.
# systemd parses this file itself. source does not reproduce that parse.
# An unquoted backslash escapes the next character. \\ is one backslash.
# Confirm a value that contains a backslash, a quote, or leading or trailing whitespace on the target host.
# Copy to /etc/vectornntp/storageservice.env as root:root mode 0600, then replace the placeholder with sudoedit.
# Do not commit the installed file.
ConnectionStrings__NntpDB=Server=REPLACE_WITH_MYSQL_HOST;User ID=REPLACE_WITH_MYSQL_USER;Password=REPLACE_WITH_MYSQL_PASSWORD;Database=REPLACE_WITH_DATABASE_NAME
# These shared names are not required in /etc/vectornntp/storageservice.env.
# StorageService does not take them from this file. nntpsharedconfig supplies them after the connection string works.
# VECTOR__RABBITMQ__USERNAME
# VECTOR__RABBITMQ__PASSWORD
# VECTOR__CLOUDFLAREAPIKEY
# VECTOR__CLOUDFLAREZONEID
# VECTOR__ACMEACCOUNT
# VECTOR__ACMECERTIFICATEPASSWORD
